# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mint
DB_USER=mint
DB_PASSWORD=mintpassword

# JWT Configuration (Must be at least 256 bits / 32 characters for HMAC-SHA256)
JWT_SECRET=super-secret-jwt-key-that-is-at-least-32-bytes-long-for-mint-app
JWT_EXPIRATION_MS=900000        # 15 minutes in milliseconds
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days in milliseconds
